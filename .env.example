# Copy to .env and adjust. `.env` is gitignored; docker compose reads it for the
# ${...} interpolations in docker-compose.yml.
#
# Shared secret for Velocity modern forwarding. MUST be identical on the proxy
# and every backend (the entrypoint injects it into both velocity.toml's secret
# file and FabricProxy-Lite via its FABRIC_PROXY_SECRET env var). Change it.
FORWARDING_SECRET=linkedhardcore-dev-secret-change-me

# JVM heap for the proxy and each backend server.
MC_MEMORY=3G

# How long the on-screen "transferring" countdown runs after a death (seconds).
TRANSFER_COUNTDOWN_SECONDS=5

# Host port the proxy is published on (container always binds 25577).
VELOCITY_PORT=25577
